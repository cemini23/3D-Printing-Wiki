# =============================================================================
# 3D Printing Research Workspace — .gitignore
# =============================================================================
# Tracked: CLAUDE.md, LESSONS.md, ROADMAP.md, wiki/, scripts/, .gitignore, .env.example
# Untracked: raw sources, briefs, .env, .claude/, OS cruft
# =============================================================================

# --- Raw sources (large, copyrighted, immutable; live local only) ------------
research to be indexed/
raw-sources/

# --- Outputs staged for distribution -----------------------------------------
briefs/

# --- Claude Code per-project state -------------------------------------------
.claude/

# --- Session-state cache (changes every session; ephemeral) ------------------
hot.md

# --- Environment variables (secrets; .env.example is the committed template) -
.env

# --- macOS / editor cruft ----------------------------------------------------
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
.obsidian/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Temp scratch ------------------------------------------------------------
/tmp_*.txt
/tmp_*.md
*.tmp

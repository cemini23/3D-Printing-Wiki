# ============================================================================
# 3D Printing Research Workspace — Environment Variables Template
# ============================================================================
# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored — never commit real keys.
# ============================================================================

# DeepSeek API — for AI-assisted design and research
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Brave Search API — for the brave-search MCP server (optional; web search via MCP)
# Get a key at https://api.search.brave.com/
BRAVE_API_KEY=

# Exa API — for the exa MCP server and daily research digest (optional)
# Get a key at https://exa.ai/
# Digest: scripts/daily_research_digest_run.py → wiki/sweeps/ + optional arXiv PDFs to inbox
EXA_API_KEY=
